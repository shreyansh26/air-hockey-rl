#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
mkdir -p "$ROOT/training/runs" "$ROOT/validation"
for directory in "$ROOT/.tools" "$ROOT/builds" "$ROOT/training/runs" "$ROOT/training/.venv" "$ROOT/validation"; do
  if [ -d "$directory" ]; then
    touch "$directory/.gdignore"
  fi
done
if [ "$(uname -s)" = Darwin ]; then
  exec "$ROOT/.tools/Godot.app/Contents/MacOS/Godot" "$@"
fi
exec "$ROOT/.tools/Godot_v4.5.1-stable_linux.x86_64" "$@"
